# Copy to .env and fill in values. .env is gitignored.

# --- API + Web ---
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Storage backend ---
# Set to "memory" for tests; "postgres" for real local dev.
VOICE_AGENT_STORAGE=postgres

# --- Postgres ---
POSTGRES_USER=voice_agent
POSTGRES_PASSWORD=voice_agent
POSTGRES_DB=voice_agent_demo
DATABASE_URL=postgresql+psycopg://voice_agent:voice_agent@localhost:5432/voice_agent_demo

# --- Qdrant (vector store for knowledge RAG) ---
QDRANT_URL=http://localhost:6333

# --- MinIO (S3-compatible object store for recordings) ---
MINIO_ROOT_USER=voiceagent
MINIO_ROOT_PASSWORD=voiceagentdemo

# --- LLM (Groq, OpenAI-compatible) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# --- LiveKit Cloud (for browser voice transport) ---
# Sign up at https://cloud.livekit.io and create a project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram (streaming STT) ---
# Sign up at https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Cartesia (low-latency TTS) ---
# Sign up at https://play.cartesia.ai
CARTESIA_API_KEY=
# Optional: override the receptionist voice. Default is a warm female voice.
CARTESIA_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238

# --- Auth / security ---
# JWT_SECRET signs session tokens — generate a strong random value for prod:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRE_HOURS=168
# SERVICE_API_KEY authenticates the voice worker to internal API endpoints on
# phone calls (no operator session). Generate a strong random value for prod.
SERVICE_API_KEY=dev-service-key-change-me
# Seed admin created on first boot if no superuser exists.
SEED_ADMIN_EMAIL=admin@voiceops.dev
SEED_ADMIN_PASSWORD=voiceops-dev

# --- Worker → API callback URL ---
# Where the voice worker reaches the API. Localhost for dev; your public API
# URL in production (e.g. https://api.yourdomain.com).
API_PUBLIC_URL=http://localhost:8000

# --- Twilio (only needed for outbound calling, a later phase) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
